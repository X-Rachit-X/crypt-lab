# ═══════════════════════════════════════════════════════════════════════════
# Crypt Lab IDS — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# This file contains all configurable settings for the IDS system.
# IMPORTANT: Copy this to .env, fill in API keys, and NEVER commit .env to git!
#
# To generate a new AES-256 key:
#   python3 -c "import os,binascii; print(binascii.hexlify(os.urandom(32)).decode())"
#
# To find your network interface:
#   ip link show
#
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# GOOGLE GEMINI AI (For AI-generated countermeasures & analysis)
# ─────────────────────────────────────────────────────────────────────────

# Get a free API key at: https://aistudio.google.com
# Free tier: 60 requests/minute
GEMINI_API_KEY=

# Recommended models (latest first):
#   - gemini-2.0-flash (latest, fastest)
#   - gemini-1.5-pro (most capable)
#   - gemini-1.5-flash (fast)
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────────────────
# IDS CORE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# ML model directory (contains ids_model.pkl, label_encoder.pkl, feature_list.pkl)
IDS_MODEL_DIR=./model

# AES-256 encryption key for alert payloads (hex, 64 chars)
# REQUIRED! Generate with: python3 -c "import os,binascii; print(binascii.hexlify(os.urandom(32)).decode())"
IDS_AES_KEY=

# Network interface to capture packets on (find yours with: ip link show)
# Examples: eth0, enp3s0, wlan0, en0 (macOS)
CAPTURE_INTERFACE=enp3s0

# Log files to monitor (comma-separated paths)
# Common paths: /var/log/auth.log, /var/log/syslog, /var/log/nginx/access.log
LOG_PATHS=/var/log/syslog,/var/log/auth.log,/var/log/nginx/access.log

# ─────────────────────────────────────────────────────────────────────────
# GEO-LOCATION (Optional — ipinfo.io)
# ─────────────────────────────────────────────────────────────────────────

# Free tier without token: 50,000 requests/month
# Get a free token at: https://ipinfo.io/signup
# Leave blank for free tier (rate limited)
IPINFO_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# ANALYSIS & BEHAVIOR TUNING
# ─────────────────────────────────────────────────────────────────────────

# Enable AI analysis of alerts (true/false)
ANALYSIS_ENABLED=true

# Max characters of alert context to send to Gemini per request
# Smaller = faster + cheaper API calls; larger = more detailed analysis
ANALYSIS_SAMPLE_SIZE=2000

# Minimum milliseconds between Gemini API calls (debounce/throttle)
# Prevents API spam during rapid alert generation
ANALYSIS_DEBOUNCE_MS=2500

# ─────────────────────────────────────────────────────────────────────────
# DEBUG & LOGGING
# ─────────────────────────────────────────────────────────────────────────

# Enable verbose debug logging (true/false)
# Warning: May print API keys or sensitive data if true
DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════
# NOTES & OPTIMIZATION
# ═══════════════════════════════════════════════════════════════════════════
#
# ANALYSIS_SAMPLE_SIZE: 2000 chars
#   → Balances detail with API cost
#   → ~400-500 tokens to Gemini
#   → Captures meaningful threat context
#
# ANALYSIS_DEBOUNCE_MS: 2500ms
#   → ~24 analyses/minute max
#   → Prevents API rate limits (60 req/minute)
#   → Still near real-time user feedback
#   → Frontend auto-queues pending analysis
#
# Frontend optimization:
#   → Page Visibility API pauses WebSocket when tab hidden
#   → Reduces server load & bandwidth when not monitoring
#
# Security notes:
#   → Never commit this file with real keys to git
#   → Keep IDS_AES_KEY strong (64 random hex chars)
#   → Rotate API keys quarterly
#   → Use .env in .gitignore
#
# Performance tuning:
#   → Reduce ANALYSIS_SAMPLE_SIZE for faster API calls
#   → Increase ANALYSIS_DEBOUNCE_MS to reduce API quota usage
#   → Set ANALYSIS_ENABLED=false to disable AI features entirely
#
# ═══════════════════════════════════════════════════════════════════════════
