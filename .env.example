# Runtime environment variables for Cybersecurity Attack Simulation Lab
# IMPORTANT: Do NOT commit real secrets. Keep this file local.
# Fill in your real Gemini API key below, then restart the server.

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Real-time analysis behavior (OPTIMIZED for reduced API call load)
ANALYSIS_ENABLED=true
ANALYSIS_SAMPLE_SIZE=2000
ANALYSIS_DEBOUNCE_MS=2500

# Optional debug logging (no secrets printed)
DEBUG=false

# === OPTIMIZATION NOTES ===
# ANALYSIS_SAMPLE_SIZE: Reduced from 4000 to 2000 chars
#   - Fewer tokens sent to Gemini API = faster calls + lower quota usage
#   - Still captures meaningful logs for security analysis
# ANALYSIS_DEBOUNCE_MS: Increased from 1200ms to 2500ms
#   - Analysis runs ~50% less frequently
#   - Prevents API spam during rapid terminal activity
#   - User still gets near-real-time insights
# Frontend: Page Visibility API pauses stats polling when tab is hidden
#   - Further reduces WebSocket traffic and API calls when not monitoring
