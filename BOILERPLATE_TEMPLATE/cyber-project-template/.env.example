# Environment variables for Cyber Project Template
# IMPORTANT: Do NOT commit real secrets. Keep .env local and .gitignored.
# Copy this file to .env and fill in your real values.

# Google Gemini API (optional, required for AI analysis features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Real-time analysis behavior (OPTIMIZED for reduced API call load)
ANALYSIS_ENABLED=true
ANALYSIS_SAMPLE_SIZE=2000
ANALYSIS_DEBOUNCE_MS=2500

# Optional: Enable verbose logging
DEBUG=false

# === OPTIMIZATION NOTES ===
# ANALYSIS_SAMPLE_SIZE: Default 2000 chars (vs 4000 in older versions)
#   - Reduces token count sent to Gemini
#   - Faster API calls + lower quota usage
#   - Still captures meaningful logs for analysis
#
# ANALYSIS_DEBOUNCE_MS: Default 2500ms (vs 1200ms in older versions)
#   - Reduces analysis frequency by ~50%
#   - Prevents API spam during rapid terminal activity
#   - User still gets near-real-time insights
#
# Frontend optimization:
#   - Page Visibility API pauses stats polling when tab is hidden
#   - Further reduces WebSocket traffic and server load
